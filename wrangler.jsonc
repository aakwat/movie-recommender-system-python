{
  "name": "movies",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // Per-version preview URLs would keep old deploys publicly reachable.
  "preview_urls": false,
  // Static only: no Worker script, so requests are free and never cold-start.
  "assets": {
    "directory": "./site"
  }
}
